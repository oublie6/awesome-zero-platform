{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "types": [
      "@cocos/creator-types/engine"
    ],
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "assets/scripts/**/*.ts"
  ]
}
