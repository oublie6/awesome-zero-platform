<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title><%= projectName %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <link rel="stylesheet" href="<%= cssUrl %>">
  <style>
    html, body { width: 100%; height: 100%; overflow: hidden; background: #0b181b; }
    #GameDiv { width: 100vw; height: 100vh; margin: 0; border: 0; border-radius: 0; box-shadow: none; }
  </style>
</head>
<body>
  <div id="GameDiv" cc_exact_fit_screen="false">
    <div id="Cocos3dGameContainer"><canvas id="GameCanvas" tabindex="0"></canvas></div>
  </div>
  <%- include(cocosTemplate, {}) %>
  <script>
    System.import('cc').then((engine) => {
      engine.game.once(engine.Game.EVENT_ENGINE_INITED, () => {
        // Desktop subframes need an explicit physical size; CSS alone stretches
        // the old framebuffer. Use the public API and the engine's capped DPR.
        const resize = () => {
          const dpr = engine.screen.devicePixelRatio;
          engine.screen.windowSize = new engine.Size(window.innerWidth * dpr, window.innerHeight * dpr);
        };
        resize();
        window.addEventListener('resize', resize);
        window.addEventListener('pagehide', (event) => {
          if (!event.persisted) window.removeEventListener('resize', resize);
        });
      });
    }).catch((error) => console.error(error));
  </script>
</body>
</html>
