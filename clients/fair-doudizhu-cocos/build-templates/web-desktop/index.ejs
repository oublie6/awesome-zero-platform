<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title><%= projectName %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <!-- Native loading UI is self-styled; noncritical Cocos CSS is loaded after its watchdog. -->
  <style>
    html, body { width: 100%; height: 100%; margin: 0 !important;
      overflow: hidden; background: #0b181b; }
    /* The deferred native CSS arrives after these rules. Its default 5px
       #GameDiv border and centering must never change the game viewport. */
    #GameDiv { width: 100vw !important; height: 100vh !important;
      margin: 0 !important; border: 0 !important; border-radius: 0 !important;
      box-shadow: none !important; box-sizing: border-box !important; }
    #Cocos3dGameContainer { width: 100%; height: 100%; }
    #GameCanvas { display: block; width: 100%; height: 100%; }
    #azp-boot { position: fixed; z-index: 2147483647; inset: 0; display: flex; align-items: center;
      justify-content: center; background: radial-gradient(circle at 50% 30%,#244b36,#0a1815 70%);
      font-family: system-ui, sans-serif; color: #f3e4be; text-align: center; padding: 20px; }
    #azp-boot.gone { opacity: 0; pointer-events: none; transition: opacity .3s ease; }
    .azp-boot-panel { width: min(420px, 94vw); }
    .azp-boot-suit { margin: 0 auto 18px; width: 76px; height: 76px; border-radius: 22px;
      background: #d6e3b7; color: #1f4835; font-size: 55px; display: grid; place-items: center; }
    .azp-boot-title { font-size: 29px; font-weight: 650; letter-spacing: 2px; margin: 0 0 13px; }
    #azp-boot-status { font-size: 14px; color: #d5e4d4; margin-bottom: 16px; }
    .azp-boot-track { width: 100%; height: 9px; overflow: hidden; border-radius: 99px; background: #345443; }
    #azp-boot-fill { height: 100%; width: 0; border-radius: 99px;
      background: linear-gradient(90deg,#91c8a3,#e6c17d); transition: width .3s ease; }
    #azp-boot-step { color: #a4bda9; font-size: 11px; margin-top: 12px; }
    #azp-boot-retry { display: none; margin: 20px auto 0; color: #203b2b; background: #d5e3b7;
      border: 0; border-radius: 10px; font: inherit; font-size: 14px; padding: 12px 20px; cursor: pointer; }
    #azp-boot.slow #azp-boot-retry,#azp-boot.failed #azp-boot-retry { display: block; }
    @media (prefers-reduced-motion: reduce) { #azp-boot.gone,#azp-boot-fill { transition: none; } }
  </style>
</head>
<body>
  <div id="azp-boot" role="status" aria-live="polite">
    <div class="azp-boot-panel">
      <div class="azp-boot-suit" aria-hidden="true">♠</div>
      <h1 class="azp-boot-title">公平斗地主</h1>
      <p id="azp-boot-status">正在准备游戏页面…</p>
      <div class="azp-boot-track" role="progressbar" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0" aria-label="启动阶段">
        <div id="azp-boot-fill"></div>
      </div>
      <p id="azp-boot-step">启动阶段加载中 · 非资源下载百分比</p>
      <button id="azp-boot-retry" type="button">重新加载</button>
    </div>
  </div>
  <script>
    (() => {
      const root = document.getElementById('azp-boot');
      const bar = document.getElementById('azp-boot-fill');
      const track = root.querySelector('[role="progressbar"]');
      const status = document.getElementById('azp-boot-status');
      const step = document.getElementById('azp-boot-step');
      const phases = {
        document: [1, '正在读取游戏页面'],
        engine: [2, '游戏引擎初始化完成'],
        scene: [3, '正在准备游戏大厅'],
        session: [3, '正在验证服务器会话并恢复房间']
      };
      let current = 0, complete = false, slow = 0, deadline = 0;
      // A failed boot generation never becomes ready through a late callback.
      let terminalFailure = false, deferredFailure = false;
      let suspended = false, stylesheetLoaded = false, geometryReady = false, pendingCompletion = false;
      function visible() {
        if (document.hidden) return false;
        try { return !window.frameElement || window.frameElement.getClientRects().length > 0; }
        catch { return true; }
      }
      function message(type, stage) {
        if (window.parent !== window)
          window.parent.postMessage({ protocol: 'azp-doudizhu-frame-v1', type, stage }, window.location.origin);
      }
      function stop() { clearTimeout(slow); clearTimeout(deadline); }
      function arm() {
        stop();
        if (complete || terminalFailure) return;
        if (suspended || !visible()) { suspended = true; return; }
        slow = setTimeout(() => { if (!complete && !suspended) root.classList.add('slow'); }, 15000);
        deadline = setTimeout(() => { if (!complete && !suspended) fail(); }, 60000);
      }
      function pause() {
        suspended = true;
        stop();
        root.classList.remove('slow');
      }
      function resume() {
        if (!visible() || complete) return;
        suspended = false;
        if (deferredFailure) { showFailure(); return; }
        if (!terminalFailure) arm();
      }
      function stage(name) {
        const item = phases[name];
        if (!item || complete || terminalFailure ||
            (item[0] <= current && name !== 'session')) return;
        current = item[0];
        status.textContent = item[1];
        bar.style.width = current * 25 + '%';
        track.setAttribute('aria-valuenow', String(current));
        step.textContent = '已确认 ' + current + ' / 4 个启动阶段 · 非下载百分比';
        root.classList.remove('slow');
        arm();
        message('BOOT_STAGE', name);
      }
      function showFailure() {
        if (root.classList.contains('failed')) return;
        deferredFailure = false;
        root.classList.add('failed');
        status.textContent = '游戏资源或引擎启动失败';
        step.textContent = '请检查网络连接，或重新加载游戏';
        message('BOOT_FAILED');
      }
      function fail() {
        if (complete || terminalFailure) return;
        terminalFailure = true;
        stop();
        if (suspended || !visible()) { deferredFailure = true; return; }
        showFailure();
      }
      function done() {
        if (complete || terminalFailure) return;
        // A fast engine cannot expose an unstyled or physically invalid canvas.
        if (!stylesheetLoaded || !geometryReady) { pendingCompletion = true; return; }
        complete = true;
        stop();
        bar.style.width = '100%';
        track.setAttribute('aria-valuenow', '4');
        root.classList.add('gone');
        setTimeout(() => root.remove(), 350);
      }
      document.getElementById('azp-boot-retry').addEventListener('click', () => {
        // Explicit retry starts a new page generation. Freeze this one's
        // timers and completion callbacks while Vue replaces the old iframe.
        terminalFailure = true;
        stop();
        if (window.parent === window) window.location.reload();
        else message('BOOT_RETRY_REQUESTED');
      });
      // Report failed engine scripts without logging URLs or credential material.
      window.addEventListener('error', (event) => {
        if (!complete && current < 3 && (event.target instanceof HTMLScriptElement ||
            (event.target instanceof HTMLLinkElement && event.target.rel === 'stylesheet'))) fail();
      }, true);
      window.addEventListener('message', (event) => {
        if (event.source !== window.parent || event.origin !== window.location.origin ||
            !event.data || event.data.protocol !== 'azp-doudizhu-frame-v1') return;
        if (event.data.type === 'BOOT_PAUSE') pause();
        else if (event.data.type === 'BOOT_RESUME') resume();
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) pause();
        else if (visible()) resume();
      });
      suspended = !visible();
      window.__AZP_BOOT__ = { stage, done, fail };
      // CSS loaded is not proof the canvas has a usable physical viewport.
      // The engine reports geometry only after setting a positive Cocos size.
      window.__AZP_GEOMETRY_READY__ = new Promise((resolve) => {
        window.__AZP_MARK_GEOMETRY_READY__ = () => {
          if (terminalFailure || !stylesheetLoaded || geometryReady) return;
          geometryReady = true;
          resolve(true);
          if (pendingCompletion) done();
        };
      });
      stage('document');
      // Parser-blocking CSS previously prevented this UI/watchdog from even
      // existing. A nonmatching media stylesheet downloads without blocking
      // first paint and is applied only after its actual load event.
      window.__AZP_STYLE_READY__ = new Promise((resolve) => {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.media = 'print';
        css.href = <%- JSON.stringify(cssUrl) %>;
        let settled = false;
        function finish(ok) {
          if (settled) return;
          settled = true;
          if (ok && !terminalFailure) {
            css.media = 'all';
            stylesheetLoaded = true;
            window.__AZP_STYLE_LOADED__ = true;
            resolve(true);
            if (pendingCompletion && geometryReady) done();
          } else {
            resolve(false);
            fail();
          }
        }
        css.onload = () => finish(true);
        css.onerror = () => finish(false);
        document.head.appendChild(css);
      });
    })();
  </script>
  <div id="GameDiv" cc_exact_fit_screen="false">
    <div id="Cocos3dGameContainer"><canvas id="GameCanvas" tabindex="0"></canvas></div>
  </div>
  <%- include(cocosTemplate, {}) %>
  <script>
    System.import('cc').then((engine) => {
      engine.game.once(engine.Game.EVENT_ENGINE_INITED, () => {
        // A display:none iframe can have positive innerWidth but 0x0 content.
        // Never let invalid physical geometry abort EVENT_ENGINE_INITED.
        const container = document.getElementById('Cocos3dGameContainer');
        const gameDiv = document.getElementById('GameDiv');
        let appliedWidth = 0, appliedHeight = 0, queued = false, disposed = false;
        const resize = () => {
          if (disposed || document.hidden) return;
          try {
            if (window.frameElement && !window.frameElement.getClientRects().length) return;
            const outer = gameDiv?.getBoundingClientRect();
            const inner = container?.getBoundingClientRect();
            if (!outer || !inner || outer.width <= 0 || outer.height <= 0 ||
                inner.width <= 0 || inner.height <= 0) return;
            const dpr = engine.screen.devicePixelRatio;
            if (!Number.isFinite(dpr) || dpr <= 0) return;
            const width = Math.round(inner.width * dpr);
            const height = Math.round(inner.height * dpr);
            if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 ||
                height <= 0 || (width === appliedWidth && height === appliedHeight)) return;
            try {
              engine.screen.windowSize = new engine.Size(width, height);
              appliedWidth = width;
              appliedHeight = height;
              if (window.__AZP_STYLE_LOADED__ === true)
                window.__AZP_MARK_GEOMETRY_READY__?.();
            } catch {
              // A transient resize race must not stop the engine. The next
              // observer/BOOT_RESUME will retry once valid geometry returns.
            }
          } catch {
            // Detached/temporarily hidden frames are recoverable.
          }
        };
        const scheduleResize = () => {
          if (disposed || queued) return;
          queued = true;
          window.requestAnimationFrame(() => { queued = false; resize(); });
        };
        const onResume = (event) => {
          if (event.source !== window.parent || event.origin !== window.location.origin ||
              !event.data || event.data.protocol !== 'azp-doudizhu-frame-v1' ||
              event.data.type !== 'BOOT_RESUME') return;
          scheduleResize();
        };
        const observer = typeof ResizeObserver === 'function' ?
          new ResizeObserver(scheduleResize) : null;
        if (gameDiv) observer?.observe(gameDiv);
        if (container) observer?.observe(container);
        window.addEventListener('resize', scheduleResize);
        window.addEventListener('message', onResume);
        document.addEventListener('visibilitychange', scheduleResize);
        // If CSS arrives after engine initialization, remeasure even when
        // ResizeObserver is unavailable (and BOOT_RESUME was not needed).
        void window.__AZP_STYLE_READY__?.then(ok => {
          if (ok) {
            appliedWidth = 0;
            appliedHeight = 0;
            scheduleResize();
          }
        }).catch(() => {});
        window.addEventListener('pagehide', (event) => {
          if (event.persisted) return;
          disposed = true;
          observer?.disconnect();
          window.removeEventListener('resize', scheduleResize);
          window.removeEventListener('message', onResume);
          document.removeEventListener('visibilitychange', scheduleResize);
        });
        scheduleResize();
        window.__AZP_BOOT__?.stage('engine');
      });
    }).catch((error) => { window.__AZP_BOOT__?.fail(); console.error(error); });
  </script>
</body>
</html>
